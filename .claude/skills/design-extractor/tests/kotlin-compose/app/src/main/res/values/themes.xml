<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fixture" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- 2-level chain: Theme.Fixture.Translucent → Theme.Fixture → framework -->
    <style name="Theme.Fixture.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="RatingStar">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">@dimen/notification_touch_target</item>
        <item name="android:gravity">center</item>
        <item name="android:text">@string/star_glyph</item>
        <item name="android:textSize">@dimen/notification_star_size</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="RatingAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">@dimen/notification_touch_target</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Notification</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
</resources>
